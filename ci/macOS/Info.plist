	<!-- Independent of CMAKE_OSX_DEPLOYMENT_TARGET. This is what makes macOS
	     REFUSE to launch on an older system with a clear message, instead of
	     launching and then crashing on a missing symbol. Homebrew bottles on
	     the build host are compiled against the macOS 26 SDK, so 26.0 is the
	     real floor. -->
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>
	<!-- macOS gates ~/Documents, ~/Desktop and ~/Downloads behind user
	     consent. The default model-repository folder is
	     ~/Documents/FEBio Studio Repo Files, so without these the consent
	     prompt is generic and a denial shows up only as an empty repository.
	     These strings are what the user is asked to approve. -->
	<key>NSDocumentsFolderUsageDescription</key>
	<string>FEBio Studio stores downloaded models from the FEBio model repository in your Documents folder.</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>FEBio Studio needs access to your Downloads folder to open and save model files stored there.</string>
	<key>NSDesktopFolderUsageDescription</key>
	<string>FEBio Studio needs access to your Desktop to open and save model files stored there.</string>
	<key>CSResourcesFileMapped</key>
	<true/>
