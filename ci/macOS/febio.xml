<?xml version="1.0" encoding="ISO-8859-1"?>
<!--
    FEBio configuration shipped inside FEBioStudio.app.

    Installed to Contents/Resources/febio.xml, NOT Contents/MacOS. codesign
    seals Contents/MacOS as code, so a data file there makes signing the bundle
    fail with "code object is not signed at all".

    No default_linear_solver is set here on purpose. FEBio (built with
    PDL_RUNTIME_LOAD) chooses the default at start-up: "pardiso-project" if the
    user has installed a licensed Panua Pardiso library (e.g. in
    ~/Library/Application Support/FEBio/lib/libpardiso.dylib, or wherever
    PARDISO_LIB_PATH points), otherwise "accelerate". Setting a solver here
    would override that choice, and users cannot edit this file without
    breaking the app's code signature.
-->
<febio_config version="3.0">
    <!-- same as FEBio's built-in default; present only because the config
         parser expects at least one child element -->
    <show_warnings_and_errors>1</show_warnings_and_errors>
</febio_config>
